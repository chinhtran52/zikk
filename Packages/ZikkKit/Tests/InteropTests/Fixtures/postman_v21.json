{
  "info": {
    "_postman_id": "2b1f6f2e-7d3c-4e2e-9a3d-3b8f0a1c9e11",
    "name": "Pet Store",
    "description": "Sample **collection**",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "event": [
    { "listen": "prerequest", "script": { "type": "text/javascript", "exec": ["pm.variables.set('ts', Date.now());"] } },
    { "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('ok', () => {", "  pm.response.to.have.status(200);", "});"] } }
  ],
  "variable": [
    { "key": "baseUrl", "value": "https://petstore.example.com/v1", "type": "string" },
    { "key": "token", "value": "abc", "type": "secret" }
  ],
  "item": [
    {
      "name": "Pets",
      "description": "Pet operations",
      "item": [
        {
          "name": "List pets",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }, { "key": "X-Debug", "value": "1", "disabled": true }],
            "url": {
              "raw": "{{baseUrl}}/pets?limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["pets"],
              "query": [{ "key": "limit", "value": "10" }, { "key": "offset", "value": "0", "disabled": true }]
            },
            "description": "Returns all pets"
          },
          "response": [
            {
              "name": "Success",
              "originalRequest": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/pets?limit=10" } },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "[{\"id\": 1, \"name\": \"Rex\"}]"
            }
          ]
        },
        {
          "name": "Get pet",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/pets/:petId",
              "host": ["{{baseUrl}}"],
              "path": ["pets", ":petId"],
              "variable": [{ "key": "petId", "value": "42" }]
            }
          }
        },
        {
          "name": "Create pet",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('created', () => pm.response.to.have.status(201));"] } }],
          "request": {
            "method": "POST",
            "header": [],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Rex\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/pets"
          }
        }
      ]
    },
    {
      "name": "Upload",
      "request": {
        "auth": { "type": "apikey", "apikey": [{ "key": "key", "value": "X-API-Key" }, { "key": "value", "value": "k" }, { "key": "in", "value": "header" }] },
        "method": "POST",
        "body": {
          "mode": "formdata",
          "formdata": [
            { "key": "name", "value": "photo", "type": "text" },
            { "key": "file", "type": "file", "src": "/tmp/photo.png" }
          ]
        },
        "url": { "raw": "https://upload.example.com:8443/files", "protocol": "https", "host": ["upload", "example", "com"], "port": "8443", "path": ["files"] }
      }
    },
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "body": { "mode": "urlencoded", "urlencoded": [{ "key": "user", "value": "a" }, { "key": "pass", "value": "b" }] },
        "url": "{{baseUrl}}/login"
      }
    }
  ]
}
